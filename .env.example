# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Django core ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
# Comma-separated host names this server answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Demo API key (optional) ---
# Accepted by the API and pre-filled on the demo page at "/". Anyone who can open that page
# can read it, so leave it empty for real deployments. Min 32 chars. Generate one with:
#   python -c "import secrets; print('fr_' + secrets.token_urlsafe(32))"
DEMO_API_KEY=

# --- PostgreSQL ---
DB_NAME=fuelroute
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Redis (cache + rate-limit counters) ---
# REDIS_PORT is the host port docker-compose publishes Redis on; keep REDIS_URL in sync.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# --- CORS: comma-separated origins of the web pages allowed to call the API ---
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Upstream services ---
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires an identifying User-Agent (add a real contact URL/email in production).
# Placeholder values like you@example.com are rejected with HTTP 403.
NOMINATIM_USER_AGENT=fuelroute-api/1.0 (you@example.com)

# --- Rate limits (DRF format: "<count>/<second|minute|hour|day>") ---
THROTTLE_RATE_ROUTE=30/minute
THROTTLE_RATE_BURST=5/second
# The public health check has its own budget. Keep it comfortably above the combined rate of
# every probe that shares one source address, or a balancer will read a 429 as "unhealthy".
THROTTLE_RATE_HEALTH=120/minute

# --- Production-only HTTPS hardening (only applied when DJANGO_DEBUG=False) ---
SECURE_SSL_REDIRECT=True
